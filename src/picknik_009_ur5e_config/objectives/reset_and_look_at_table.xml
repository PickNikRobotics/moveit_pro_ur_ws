<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Reset And Look at Table">
  <BehaviorTree
    ID="Reset And Look at Table"
    _description="Reset the planning scene, move the arm to face the table surface, and let go of anything held (vacuum off on the suction cup, fingers open on the 2F-85)."
    _favorite="true"
  >
    <Control ID="Sequence" name="TopLevelSequence">
      <SubTree
        ID="Reset Planning Scene"
        name="Reset Planning Scene"
        _collapsed="true"
      />
      <!--Look at Table rather than a direct Move to Waypoint: the old call passed
          keep_orientation ports MoveIt Pro 10 retired, which failed the whole
          Objective at build time.-->
      <SubTree ID="Look at Table" _collapsed="true" />
      <!--The gripper switching subtree, so this works on both end effectors: the
          suction cup turns the vacuum off, the 2F-85 opens.-->
      <SubTree ID="Release Product" _collapsed="true" />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Reset And Look at Table">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="2. Hardware Control" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>
