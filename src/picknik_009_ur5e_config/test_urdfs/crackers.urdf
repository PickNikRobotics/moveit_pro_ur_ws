<?xml version="1.0" ?>
<!-- Crackers: box 7cm deep x 13cm wide x 20cm tall -->
<robot name="crackers">
  <link name="crackers_link">
    <visual>
      <geometry>
        <box size="0.07 0.13 0.20"/>
      </geometry>
      <material name="crackers_color">
        <color rgba="0.85 0.65 0.13 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.07 0.13 0.20"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>
</robot>
