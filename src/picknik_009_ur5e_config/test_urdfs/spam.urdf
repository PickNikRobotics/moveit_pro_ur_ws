<?xml version="1.0" ?>
<!-- Spam: box 6cm deep x 10cm wide x 9cm tall -->
<robot name="spam">
  <link name="spam_link">
    <visual>
      <geometry>
        <box size="0.06 0.10 0.09"/>
      </geometry>
      <material name="spam_color">
        <color rgba="0.20 0.35 0.70 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.06 0.10 0.09"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.35"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>
</robot>
