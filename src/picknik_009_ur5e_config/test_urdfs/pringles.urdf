<?xml version="1.0" ?>
<!-- Pringles: cylinder 8cm diameter x 23cm tall -->
<robot name="pringles">
  <link name="pringles_link">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.23"/>
      </geometry>
      <material name="pringles_color">
        <color rgba="0.80 0.10 0.10 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.23"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>
</robot>
