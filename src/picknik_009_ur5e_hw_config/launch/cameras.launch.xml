<?xml version="1.0" encoding="UTF-8" ?>
<launch>
  <!--
    The scene camera is not pinned: an empty serial makes the driver open whichever
    D415 it finds, so a replaced scene camera works without a launch edit. That is
    only safe because the cell has exactly one D415 attached, the scene camera. A
    second D415 would race the wrist node for the device, since the driver
    enumerates in bus order, which is not stable; pin scene_camera_serial before
    attaching one. See design_docs/camera_naming.md for the naming contract these feed.

    A serial that is not on the bus is NOT a launch failure: the driver logs
    "The requested device ... is NOT found. Will Try again." and retries forever,
    so the node comes up, registers nothing, and never publishes. Downstream that
    surfaces as a GetImage / GetPointCloud five-second timeout naming the topic
    rather than anything mentioning a camera. Read the RealSense serial from the
    driver log or rs-enumerate-devices: lsusb prints a different USB serial string.
  -->

  <arg
    name="scene_camera_serial"
    default=""
    description="RealSense SDK serial to assign to scene_camera. Empty (the default) opens whichever D415 is attached, which is right only while the scene camera is the one D415 connected."
  />
  <arg
    name="launch_wrist_camera"
    default="true"
    description="Whether to launch the wrist-mounted D415. Set false on a host
                 where that camera is not attached: a missing serial does not fail
                 the launch, it only adds a node that retries forever."
  />
  <arg
    name="launch_wrist_orbbec"
    default="true"
    description="Whether to launch the wrist-mounted Orbbec Gemini 305. Needs the
                 host Orbbec udev rule (design_docs/orbbec_wrist_camera.md); without
                 it the node runs but logs the device as not found."
  />
  <arg
    name="wrist_orbbec_dual_color"
    default="true"
    description="Run the Orbbec in its Dual Color Streams preset: the two color
                 lenses on their own left_color / right_color topics, with no depth
                 or point cloud. False gives the Default preset: one color image with
                 both lenses side by side, plus depth and the point cloud."
  />
  <arg
    name="calibration_mode"
    default="false"
    description="Run the cameras at the calibration-only resolutions. Set by the
                 picknik_009_ur5e_hw_calibration_config package, never by normal
                 runs. See design_docs/board_based_calibration.md."
  />

  <!-- Calibration mode raises the D415 color resolution. -->
  <!-- Color runs at 30 Hz so the Trainer's 10 fps divides it evenly (a D415 has
       no 10 Hz mode). Depth stays at 6 Hz: nothing records it, and it carries the
       point cloud. See design_docs/cracker_box_pick_drop_collection.md. -->
  <let
    name="d415_color_profile"
    value="640x480x30"
    unless="$(var calibration_mode)"
  />
  <let
    name="d415_color_profile"
    value="1280x720x6"
    if="$(var calibration_mode)"
  />

  <!-- Scene camera (original, over the tote). -->
  <include
    file="$(find-pkg-share picknik_009_ur5e_hw_config)/launch/pro_rs_launch.py"
  >
    <arg name="camera_name" value="scene_camera" />
    <arg name="serial_no" value="'$(var scene_camera_serial)'" />
    <arg name="device_type" value="D415" />
    <!-- No hardware reset on open. A reset makes the camera re-enumerate with new
         /dev/video* and /dev/bus/usb numbers, and the drivers container's /dev is a
         snapshot taken when it starts, so the node can only find the camera again if
         it happens to get its old numbers back. With two D415s resetting at once
         that is a race, and losing it leaves the camera "NOT found" until the next
         restart. A wedged camera (UVC "Protocol error") now needs a replug followed
         by a drivers restart. See design_docs/camera_naming.md. -->
    <arg name="initial_reset" value="false" />
    <arg name="depth_module.depth_profile" value="640x480x6" />
    <arg name="rgb_camera.color_profile" value="$(var d415_color_profile)" />
    <arg name="pointcloud.enable" value="True" />
    <arg name="pointcloud.ordered_pc" value="True" />
    <arg name="decimation_filter.enable" value="False" />
    <!--
      Load-bearing, and upstream defaults it to false. With pointcloud.enable
      true but alignment off, the point cloud publisher registers and then never
      emits a message - so the failure looks like a GetPointCloud five-second
      timeout rather than a camera or driver error. Do not drop this.
    -->
    <arg name="align_depth.enable" value="True" />
    <!--
      Fill small depth holes. Shiny flat tops (the tuna lid) lose depth under
      the D415's projector, and when a Gemini point lands in such a hole
      GetPoseFromPixelCoords finds no cloud point near it and fails the whole
      perception cycle. The spatial filter's hole filling is bounded by
      holes_fill, unlike hole_filling_filter, which fills every hole, including
      the shadows beside products, with a neighbour's depth.
      See design_docs/camera_naming.md.
    -->
    <arg name="spatial_filter.enable" value="True" />
    <arg name="spatial_filter.holes_fill" value="3" />
  </include>

  <!--
    Wrist camera. Everything reached through the "Get Wrist Image" / "Get Wrist
    Point Cloud" switching subtrees stays dead while launch_wrist_camera is false.
  -->
  <include
    file="$(find-pkg-share picknik_009_ur5e_hw_config)/launch/pro_rs_launch.py"
    if="$(var launch_wrist_camera)"
  >
    <arg name="camera_name" value="wrist_mounted_camera" />
    <!-- 217222066860 replaced 135322066258 on 2026-11-06, after that camera's USB link
         kept failing (design_docs/wrist_camera_recovery.md). -->
    <arg name="serial_no" value="'217222066860'" />
    <arg name="device_type" value="D415" />
    <!-- No hardware reset on open: see the scene camera block. -->
    <arg name="initial_reset" value="false" />
    <arg name="depth_module.depth_profile" value="640x480x6" />
    <arg name="rgb_camera.color_profile" value="$(var d415_color_profile)" />
    <arg name="pointcloud.enable" value="True" />
    <arg name="pointcloud.ordered_pc" value="True" />
    <arg name="decimation_filter.enable" value="False" />
    <!-- Load-bearing: see the scene camera block. -->
    <arg name="align_depth.enable" value="True" />
  </include>

  <!--
    Wrist cloud on the COLOR pixel grid. The driver's depth/color/points is
    organized on the depth grid, so a color pixel does not index it. Added for
    GraspScout's seal check; GraspScout was removed and nothing reads this topic
    now. Built from the driver's aligned_depth_to_color stream, which needs
    align_depth.enable above. See design_docs/camera_naming.md.
  -->
  <node
    pkg="depth_image_proc"
    exec="point_cloud_xyz_node"
    name="wrist_mounted_camera_aligned_points"
    namespace="/camera"
    if="$(var launch_wrist_camera)"
  >
    <remap
      from="image_rect"
      to="/camera/wrist_mounted_camera/aligned_depth_to_color/image_raw"
    />
    <remap
      from="camera_info"
      to="/camera/wrist_mounted_camera/aligned_depth_to_color/camera_info"
    />
    <remap from="points" to="/camera/wrist_mounted_camera/aligned_points" />
  </node>

  <!--
    Optional wrist Orbbec Gemini 305. The 2F-only driver wrapper disables the
    wrist D415 and publishes a temporary mount transform for the Orbbec root. The
    upstream launch uses camera_name as both node name and namespace, so the
    /camera prefix is pushed here to keep the /camera/<name>/... layout. See
    design_docs/orbbec_wrist_camera.md.
  -->
  <group if="$(var launch_wrist_orbbec)">
    <!-- Per-mode settings. In Dual Color Streams the combined color stream and
         depth are unsupported, and in Default the separate lenses are. -->
    <let
      name="orbbec_preset"
      value="Dual Color Streams"
      if="$(var wrist_orbbec_dual_color)"
    />
    <let
      name="orbbec_preset"
      value="Default"
      unless="$(var wrist_orbbec_dual_color)"
    />
    <let
      name="orbbec_combined"
      value="false"
      if="$(var wrist_orbbec_dual_color)"
    />
    <let
      name="orbbec_combined"
      value="true"
      unless="$(var wrist_orbbec_dual_color)"
    />
    <let
      name="orbbec_watch_topic"
      value="/camera/wrist_orbbec/left_color/camera_info"
      if="$(var wrist_orbbec_dual_color)"
    />
    <let
      name="orbbec_watch_topic"
      value="/camera/wrist_orbbec/color/camera_info"
      unless="$(var wrist_orbbec_dual_color)"
    />
    <push_ros_namespace namespace="camera" />
    <group>
      <set_remap
        from="/camera/wrist_orbbec/color/camera_info"
        to="/camera/wrist_orbbec/color/camera_info_raw"
      />
      <include
        file="$(find-pkg-share orbbec_camera)/launch/gemini305.launch.py"
      >
        <arg name="camera_name" value="wrist_orbbec" />
        <arg name="serial_number" value="CV2F861000X6" />
        <!-- Load-bearing. Include args and declared defaults leak into later
             siblings, and the upstream launch reads every arg it declares from the
             launch context, so it inherits the D415 blocks' device_type=D415. With
             that, the node crashes (exit code 11) right after "ob_camera_node_ is
             nullptr". The other three would otherwise be the RealSense values, so
             they are pinned to those to keep this block independent of the ones
             above it. -->
        <arg name="device_type" value="camera" />
        <arg name="color_qos" value="SENSOR_DATA" />
        <arg name="depth_qos" value="SENSOR_DATA" />
        <arg name="log_level" value="info" />
        <arg name="device_preset" value="$(var orbbec_preset)" />
        <arg name="enable_color" value="$(var orbbec_combined)" />
        <arg name="enable_depth" value="$(var orbbec_combined)" />
        <arg name="enable_point_cloud" value="$(var orbbec_combined)" />
        <arg name="depth_registration" value="$(var orbbec_combined)" />
        <arg name="align_target_stream" value="COLOR" />
        <arg name="enable_colored_point_cloud" value="$(var orbbec_combined)" />
      </include>
    </group>
    <node
      pkg="picknik_009_ur5e_hw_config"
      exec="orbbec_camera_info_model_relay.py"
      name="wrist_orbbec_camera_info_model_relay"
    >
      <param
        name="input_topic"
        value="/camera/wrist_orbbec/color/camera_info_raw"
      />
      <param
        name="output_topic"
        value="/camera/wrist_orbbec/color/camera_info"
      />
    </node>
    <!-- About one start in two or three the camera opens and then sends no
         frames, with no error. This reboots it through the driver when that
         happens. See design_docs/orbbec_wrist_camera.md. -->
    <node
      pkg="picknik_009_ur5e_hw_config"
      exec="orbbec_stream_watchdog.py"
      name="wrist_orbbec_stream_watchdog"
    >
      <param name="camera_info_topic" value="$(var orbbec_watch_topic)" />
      <param
        name="reboot_service"
        value="/camera/wrist_orbbec/reboot_device"
      />
      <param name="stall_timeout_s" value="10.0" />
      <param name="recovery_grace_s" value="30.0" />
      <param name="max_recovery_grace_s" value="300.0" />
    </node>
  </group>
</launch>
