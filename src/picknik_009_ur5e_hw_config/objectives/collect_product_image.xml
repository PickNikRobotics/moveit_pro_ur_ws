<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Collect Product Image">
  <BehaviorTree
    ID="Collect Product Image"
    _description="GraspScout enrollment photos. Asks for a product name, then loops: you teleop the wrist camera onto the product and press Continue, and it saves one wrist-camera PNG to user_ws/graspscout_photos/&lt;product&gt;/. Press Abort when you have enough views (5-8). The product name must match the label the shelf-stocking Objective uses (see placement_zones.yaml)."
    _favorite="false"
  >
    <Control ID="Sequence" name="TopLevelSequence">
      <!--1. Product name. It becomes the folder name, which GraspScout uses as the label.-->
      <Action
        ID="GetTextFromUser"
        prompts="Product name (must match placement_zones.yaml, e.g. crackers)"
        default_values="type_product_name"
        text_output="{user_inputs}"
      />
      <Action
        ID="GetElementOfVector"
        vector_in="{user_inputs}"
        index="0"
        element="{product_name}"
      />
      <!--Refuse the untouched default and an empty name, so no photos land in a wrong folder.-->
      <Control ID="Fallback" name="CheckProductName">
        <Decorator
          ID="Precondition"
          if="product_name != 'type_product_name' &amp;&amp; product_name != ''"
          else="FAILURE"
        >
          <Action ID="AlwaysSuccess" />
        </Decorator>
        <Control ID="Sequence">
          <Action
            ID="LogMessage"
            log_level="error"
            message="No product name entered. Run the Objective again and type the product name."
          />
          <Action ID="AlwaysFailure" />
        </Control>
      </Control>
      <!--~/user_ws is the workspace bind mount. Do not use ~/.config/moveit_pro: it is a tmpfs in the container and is lost on restart.
          SaveImageToFile creates only the last directory, so the graspscout_photos parent must already exist on the host.-->
      <Action
        ID="Script"
        name="SetPhotoDir"
        code="photo_dir := '~/user_ws/graspscout_photos/' .. product_name; photo_count := 0; capture_failed := false; start_message := 'Collecting photos for ' .. product_name .. ' into ' .. photo_dir"
      />
      <Action ID="LogMessage" log_level="info" message="{start_message}" />
      <!--2-3. Loop: teleop, Continue = take one photo, Abort = finished.
          Abort makes Request Teleoperation return FAILURE, which ends the loop; ForceSuccess turns that into a normal finish.
          A camera or save failure sets capture_failed so it is not masked as a normal finish.-->
      <Decorator ID="ForceSuccess" name="AbortEndsCollection">
        <Decorator ID="KeepRunningUntilFailure">
          <Control ID="Sequence" name="OnePhoto">
            <SubTree
              ID="Request Teleoperation"
              name="TeleopToProduct"
              _collapsed="true"
              enable_user_interaction="true"
              user_interaction_prompt="Teleop the wrist camera so the product fills the view (product alone, one face per photo: front/back/sides/top). Continue = take photo. Abort = done with this product."
              controller_action_server="/joint_trajectory_admittance_controller/follow_joint_trajectory"
              max_ik_solutions="8"
              max_mtc_solutions="1"
              initial_teleop_mode="3"
              joint_trajectory_controller_name="joint_trajectory_admittance_controller"
              default_planning_group="manipulator"
              default_ik_frame="grasp_link"
              link_padding="0.0"
              execution_pipeline="jtac"
              velocity_scale_factor="0.2"
              require_user_approval="true"
            />
            <Control ID="Fallback" name="CaptureOrFlag">
              <Control ID="Sequence" name="Capture">
                <SubTree
                  ID="Get Wrist Image"
                  _collapsed="true"
                  image="{wrist_image}"
                  camera_info="{wrist_camera_info}"
                />
                <Action
                  ID="SaveImageToFile"
                  file_path="{photo_dir}"
                  file_prefix="{product_name}"
                  image="{wrist_image}"
                />
                <Action
                  ID="Script"
                  code="photo_count += 1; photo_message := product_name .. ': saved photo ' .. photo_count .. ' (aim for 5-8)'"
                />
                <Action ID="LogMessage" log_level="info" message="{photo_message}" />
              </Control>
              <Control ID="Sequence" name="FlagCaptureFailure">
                <Action ID="Script" code="capture_failed := true" />
                <Action ID="AlwaysFailure" />
              </Control>
            </Control>
          </Control>
        </Decorator>
      </Decorator>
      <Decorator ID="Precondition" if="capture_failed == false" else="FAILURE">
        <Action
          ID="Script"
          code="done_message := product_name .. ': done, ' .. photo_count .. ' photo(s) in ' .. photo_dir"
        />
      </Decorator>
      <Action ID="LogMessage" log_level="info" message="{done_message}" />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Collect Product Image">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="7. Utilities" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>
