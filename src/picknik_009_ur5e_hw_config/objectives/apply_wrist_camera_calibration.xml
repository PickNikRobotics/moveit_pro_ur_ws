<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Apply Wrist Camera Calibration">
  <BehaviorTree
    ID="Apply Wrist Camera Calibration"
    _description="Copies one wrist camera candidate (written by a wrist calibration stage) into the wrist_camera_mount section of cell_calibration.yaml, which the robot xacro reads. Run it only once the wrist solves repeat, then restart the stack: the robot model is read at start. See design_docs/board_based_calibration.md."
    _favorite="false"
  >
    <Control ID="Sequence" name="TopLevelSequence">
      <Action
        ID="LoadPoseStampedFromYamlNamespace"
        file_path="~/user_ws/src/picknik_009_ur5e_config/objectives/calibration/cell_calibration.yaml"
        namespace="{candidate_section}"
        output="{mount_origin}"
      />
      <Action
        ID="SavePoseStampedToYaml"
        yaml_filename="~/user_ws/src/picknik_009_ur5e_config/objectives/calibration/cell_calibration.yaml"
        namespace="wrist_camera_mount"
        overwrite="false"
        message="{mount_origin}"
      />
      <Action
        ID="LogMessage"
        log_level="info"
        message="Wrist camera mount updated in cell_calibration.yaml. Restart the stack to use it."
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Apply Wrist Camera Calibration">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="3. Calibration Routine" />
      </MetadataFields>
      <input_port
        name="candidate_section"
        default="wrist_camera_mount_candidate_wall_board"
        type="std::string"
      >
        Section of cell_calibration.yaml to apply: the wall-board or the
        tote-board candidate.
      </input_port>
    </SubTree>
  </TreeNodesModel>
</root>
