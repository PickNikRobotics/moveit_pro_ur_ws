<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Check Camera Feeds">
  <BehaviorTree
    ID="Check Camera Feeds"
    _description="Checks that the three Trainer cameras (scene, wrist, shelf_cam) are delivering frames: each must deliver a new color image within the timeout. Fails naming the dead camera, so a collection run stops before it records episodes with a missing view. A RealSense node whose device stopped delivering stays advertised, so this waits for a fresh frame, not for the topic. See design_docs/camera_watchdog.md."
    _favorite="false"
  >
    <Control ID="Sequence" name="TopLevelSequence">
      <!--Topics match the Trainer Training Config (shelf_stocking_objectives' config/trainer/picknik_009_ur5e_hw_config.json).
          Each check waits for a NEW message, so a stalled camera fails even though its topic
          is still advertised.-->
      <Control ID="Fallback" name="CheckSceneCamera">
        <Action
          ID="GetImage"
          name="GetSceneCameraFrame"
          topic_name="/camera/scene_camera/color/image_raw"
          message_timeout_sec="{message_timeout_sec}"
          publisher_timeout_sec="{message_timeout_sec}"
          message_out="{camera_check_image}"
        />
        <Control ID="Sequence">
          <Action
            ID="LogMessage"
            log_level="error"
            message="Camera check: scene_camera delivered no frame. Replug it and restart the drivers (design_docs/camera_watchdog.md)."
          />
          <Action ID="AlwaysFailure" />
        </Control>
      </Control>
      <Control ID="Fallback" name="CheckWristCamera">
        <Action
          ID="GetImage"
          name="GetWristCameraFrame"
          topic_name="/camera/wrist_mounted_camera/color/image_raw"
          message_timeout_sec="{message_timeout_sec}"
          publisher_timeout_sec="{message_timeout_sec}"
          message_out="{camera_check_image}"
        />
        <Control ID="Sequence">
          <Action
            ID="LogMessage"
            log_level="error"
            message="Camera check: wrist_mounted_camera delivered no frame. Replug it and restart the drivers (design_docs/camera_watchdog.md)."
          />
          <Action ID="AlwaysFailure" />
        </Control>
      </Control>
      <Control ID="Fallback" name="CheckShelfCamera">
        <Action
          ID="GetImage"
          name="GetShelfCameraFrame"
          topic_name="/camera/shelf_cam/color/image_raw"
          message_timeout_sec="{message_timeout_sec}"
          publisher_timeout_sec="{message_timeout_sec}"
          message_out="{camera_check_image}"
        />
        <Control ID="Sequence">
          <Action
            ID="LogMessage"
            log_level="error"
            message="Camera check: shelf_cam delivered no frame. Check the ZED and restart the drivers (design_docs/zed_shelf_cam.md)."
          />
          <Action ID="AlwaysFailure" />
        </Control>
      </Control>
      <Action
        ID="LogMessage"
        log_level="info"
        message="Camera check: scene_camera, wrist_mounted_camera and shelf_cam are all delivering frames."
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Check Camera Feeds">
      <MetadataFields>
        <Metadata subcategory="8. VLA Data Collection" />
        <Metadata runnable="true" />
      </MetadataFields>
      <input_port name="message_timeout_sec" default="3.0" type="double">
        Seconds to wait for each camera's next color frame (and for its topic to be advertised).
      </input_port>
    </SubTree>
  </TreeNodesModel>
</root>
