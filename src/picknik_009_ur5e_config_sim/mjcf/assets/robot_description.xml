    <!-- <light pos="0 0 2.5" dir="0 0 -1" directional="true" /> -->
    <light
      name="key_light"
      pos="1.0 -0.5 2.5"
      dir="-0.3 0.2 -1"
      directional="true"
      castshadow="true"
      diffuse="0.55 0.53 0.48"
      specular="0.10 0.10 0.10"
    />
    <!-- Cool fill light: opposite side, no shadows, softens dark side. -->
    <light
      name="fill_light"
      pos="-1.0 1.0 2.0"
      dir="0.3 -0.2 -1"
      directional="true"
      castshadow="false"
      diffuse="0.50 0.52 0.58"
      specular="0.02 0.02 0.02"
    />
    <!-- Front light: directional, no shadow, points horizontally toward the
         shelves (+Y) with a slight downward tilt. Hits operator-facing item
         fronts at full diffuse but contributes little to top surfaces, so it
         brightens the shelved decorative items without re-washing the bin
         top-down view. -->
    <light
      name="front_light"
      pos="0 -2 1.5"
      dir="0 1 -0.2"
      directional="true"
      castshadow="false"
      diffuse="0.30 0.30 0.32"
      specular="0.05 0.05 0.05"
    />
