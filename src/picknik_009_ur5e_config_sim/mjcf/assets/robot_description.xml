  <asset>
    <!--
      Grocery-store floor: cream/gray procedural tile with subtle grout edges.
      Tile-pitch math: builtin="checker" produces a 2x2 alternating pattern
      per rep, so the visible tile is HALF the rep pitch. texrepeat="1 1" with
      texuniform="true" means 1 rep per world meter -> 0.5 m visible tiles
      (~20 inch grocery-floor pitch). Larger tiles also survive minification
      at high (top-down) camera angles, where the previous 0.25 m tiles got
      averaged away by mipmapping into a uniform gray. rgb1/rgb2 contrast is
      bumped so even when adjacent tiles blend in the mipmap chain the
      residual difference still reads. The previous mark="edge" attribute
      produced visible Moiré "wavy dark band" artifacts under mipmap
      minification at grazing camera angles, so it has been removed.
    -->
    <texture
      type="2d"
      name="groundplane"
      builtin="checker"
      mark="none"
      rgb1="0.82 0.80 0.75"
      rgb2="0.55 0.53 0.49"
      width="512"
      height="512"
    />
    <material
      name="groundplane"
      texture="groundplane"
      texuniform="true"
      texrepeat="1 1"
      specular="0.1"
      shininess="0.3"
      reflectance="0"
    />

    <!--
      Grocery-store skybox: 4-column x 3-row cube unfold (".U..LFRB.D..").
      The top cell is a cream suspended-tile ceiling with two warm
      fluorescents; the four side cells share a stylized horizon view —
      ceiling band on top, distant gondola shelving in the middle, cool
      floor band on the bottom; the bottom cell is a neutral floor color
      (covered by the actual floor plane in practice). Generated by
      generate_grocery_skybox.py — re-run to reroll the gondola layout.
    -->
    <texture
      type="skybox"
      file="textures/grocery_skybox.png"
      gridsize="3 4"
      gridlayout=".U..LFRB.D.."
    />
  </asset>

