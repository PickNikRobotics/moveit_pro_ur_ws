<sim_additions>
  <asset>
    <texture name="metal_tex" type="2d" file="textures/sheet_metal.png" />
    <!--
      Industrial-tote plastic: tileable 256x256 PNG with grayscale-only noise
      (no per-channel hue drift) plus 5 horizontal mold-rib bands. Applied
      with texuniform="false" (the default) so MuJoCo wraps the full texture
      onto every face once — every wall, regardless of size, reads at the
      same average gray. Side-effect: the rib pitch in WORLD units differs
      between long and short walls (the long wall's ribs are visually wider
      than the short wall's), but the color is uniform, which is what we
      want for "this thing is one molded plastic part".
      Generated by generate_tote_plastic.py.
    -->
    <texture
      name="tote_plastic_tex"
      type="2d"
      file="textures/tote_plastic.png"
    />
    <!--
      Shelf back-wall pegboard: 512x512 cream-painted-steel with a 20x20 hole
      grid, generated by generate_shelf_pegboard.py. Paired with texuniform
      true and texrepeat="2 2" -> 0.5 m per tile, ~25 mm hole pitch (real
      pegboard spec). Used by shelf_back; the horizontal shelf surfaces and
      the shelf base get a flat painted-metal material instead.
    -->
    <texture
      name="shelf_pegboard_tex"
      type="2d"
      file="textures/shelf_pegboard.png"
    />
    <material
      name="rack_material"
      rgba="0.65 0.68 0.72 1"
      specular="0.5"
      shininess="0.6"
    />
    <!--
      Shelf surfaces are painted steel, not wood. Two materials:
        shelf_metal_material - flat cream paint for the horizontal shelves and
                                the base panel.
        shelf_pegboard_material - same cream substrate with the pegboard hole
                                grid, used only on the vertical back wall.
      shelf_material is kept as an alias to shelf_metal_material for any
      legacy reference; new geoms should pick one of the two named materials
      explicitly.
    -->
    <material
      name="shelf_metal_material"
      rgba="0.92 0.89 0.82 1"
      specular="0.35"
      shininess="0.55"
    />
    <material
      name="shelf_pegboard_material"
      texture="shelf_pegboard_tex"
      texuniform="true"
      texrepeat="2 2"
      specular="0.3"
      shininess="0.45"
    />
    <material
      name="shelf_material"
      rgba="0.92 0.89 0.82 1"
      specular="0.35"
      shininess="0.55"
    />
    <!-- Industrial gray-plastic tote: textured, matte, slight specular.
         Also bound to calibrated_table_geom (the wood look was retired). -->
    <material
      name="bin_material"
      texture="tote_plastic_tex"
      specular="0.15"
      shininess="0.2"
    />
    <!-- Painted-metal pole: dark gray, polished. -->
    <material
      name="pole_material"
      texture="metal_tex"
      rgba="0.35 0.35 0.37 1"
      specular="0.6"
      shininess="0.85"
      reflectance="0.08"
    />
    <!-- Shelf Stocking Application workcell visual mesh (8020 frame). Visual-only in the sim:
         the planning scene gets its own collision proxy via Load Calibrated
         Scene, so we don't want MuJoCo doing collision against the same
         geometry twice. -->
    <material
      name="workcell_material"
      rgba="0.792 0.820 0.933 1"
      specular="0.4"
      shininess="0.5"
    />
    <mesh name="example_rack_1_mesh" file="racks/example_rack_1.stl" />
    <mesh name="shelf_only_mesh" file="shelf_only.stl" />
    <!-- workcell.stl is intentionally NOT loaded as a mesh asset:
         the calibrated_workcell body below renders as 9 box geoms
         for the frame plus 1 cylinder for the overhead ring light,
         matching description/workcell.urdf in the planning scene.
         The high-poly STL is preserved on disk under mjcf/assets/ as the
         spec the boxes were sized from. -->
  </asset>

  <worldbody>
    <!-- Calibrated Scene Objects (matching Load Calibrated Scene objective) -->

    <!-- Table: 1.24m x 0.63m x 0.76m. Center positioned so the front (+Y)
         face sits 0.34 m back from the robot origin and the top is flush
         with the robot base (z = 0). Matches the CreatePoseStamped/
         CreateSolidPrimitiveBox pair in load_calibrated_scene.xml. -->
    <body
      name="calibrated_table"
      pos="0 -0.655 -0.38"
      euler="0 0 0"
      gravcomp="1"
    >
      <geom
        name="calibrated_table_geom"
        type="box"
        size="0.62 0.315 0.38"
        material="bin_material"
        group="2"
      />
      <site
        name="calibrated_table_tf"
        pos="0 0 0"
        size="0.01"
        rgba="1 0 0 0.35"
      />
    </body>

    <!-- Shelf Stocking Application workcell (8020 frame + overhead ring light). 9-box + 1-
         cylinder approximation of the original workcell.stl, sized
         from per-extrusion bounding boxes of that mesh. Kept in lockstep
         with description/workcell.urdf in the planning scene —
         change box sizes/positions in both files together. Visual-only in
         the sim per design decision: the planning scene's collision
         representation comes from Load Calibrated Scene's AddURDF call, so
         MuJoCo does not need a second collision proxy for the same
         geometry. Pose mirrors the load_calibrated_scene.xml placement:
         origin at the workcell's front-right-bottom corner, rotated +90
         deg about Z (CCW from above) so the mesh-local axes line up with
         world +X right / +Y forward. -->
    <body
      name="calibrated_workcell"
      pos="0.46 -0.34 0"
      euler="0 0 1.5707963267948966"
      gravcomp="1"
    >
      <!-- 1. Top transverse crossbeam (back-wall top out to front, mid-Y) -->
      <geom
        name="calibrated_workcell_top_crossbeam"
        type="box"
        size="0.3045 0.040 0.020"
        pos="-0.4285 0.483 1.276"
        material="workcell_material"
        contype="0"
        conaffinity="0"
        group="2"
      />
      <!-- 2. Bottom-frame front rail -->
      <geom
        name="calibrated_workcell_bottom_front_rail"
        type="box"
        size="0.3045 0.020 0.020"
        pos="-0.3485 0.046 0.017"
        material="workcell_material"
        contype="0"
        conaffinity="0"
        group="2"
      />
      <!-- 3. Bottom-frame back rail -->
      <geom
        name="calibrated_workcell_bottom_back_rail"
        type="box"
        size="0.3045 0.020 0.020"
        pos="-0.3485 0.920 0.017"
        material="workcell_material"
        contype="0"
        conaffinity="0"
        group="2"
      />
      <!-- 4. Back-wall top rail (front-to-back, at top of posts) -->
      <geom
        name="calibrated_workcell_back_top_rail"
        type="box"
        size="0.020 0.457 0.020"
        pos="-0.713 0.483 1.236"
        material="workcell_material"
        contype="0"
        conaffinity="0"
        group="2"
      />
      <!-- 5. Back-wall bottom rail (also the bottom-frame back-side rail) -->
      <geom
        name="calibrated_workcell_back_bottom_rail"
        type="box"
        size="0.020 0.457 0.020"
        pos="-0.673 0.483 0.017"
        material="workcell_material"
        contype="0"
        conaffinity="0"
        group="2"
      />
      <!-- 6. Back-wall mid rail (scene-camera mount crossbar, z=0.66) -->
      <geom
        name="calibrated_workcell_back_mid_rail"
        type="box"
        size="0.020 0.457 0.020"
        pos="-0.673 0.483 0.657"
        material="workcell_material"
        contype="0"
        conaffinity="0"
        group="2"
      />
      <!-- 7. Bottom-frame front-side rail (opposite the back wall) -->
      <geom
        name="calibrated_workcell_front_bottom_rail"
        type="box"
        size="0.020 0.457 0.020"
        pos="-0.024 0.483 0.017"
        material="workcell_material"
        contype="0"
        conaffinity="0"
        group="2"
      />
      <!-- 8. Back-wall vertical post (workcell-front corner, 3"x1.5") -->
      <geom
        name="calibrated_workcell_post_front"
        type="box"
        size="0.040 0.020 0.6095"
        pos="-0.653 0.046 0.647"
        material="workcell_material"
        contype="0"
        conaffinity="0"
        group="2"
      />
      <!-- 9. Back-wall vertical post (workcell-back corner, 3"x1.5") -->
      <geom
        name="calibrated_workcell_post_back"
        type="box"
        size="0.040 0.020 0.6095"
        pos="-0.653 0.920 0.647"
        material="workcell_material"
        contype="0"
        conaffinity="0"
        group="2"
      />
      <!-- 10. Overhead ring light: a solid disk standing in for the annular
           machine-vision ring light that sits just below the top crossbeam.
           Source mesh component had OD=0.458, ID=0.342, axial thickness
           0.076; the simplified primitive is the full outer disk (no hole). -->
      <geom
        name="calibrated_workcell_ring_light"
        type="cylinder"
        size="0.229 0.038"
        pos="-0.376 0.470 1.204"
        material="pole_material"
        contype="0"
        conaffinity="0"
        group="2"
      />
      <site
        name="calibrated_workcell_tf"
        pos="0 0 0"
        size="0.01"
        rgba="1 0 0 0.35"
      />
    </body>

    <!-- Camera mount plate: 7" x 1.5" x 0.25" (0.1778 x 0.0381 x 0.00635 m).
         Sits on top of the workcell crossbar, 66 cm above the workcell base.
         The +90 deg yaw matches the planning scene placement (long edge of
         the plate ends up running along world Y / front-back). -->
    <body
      name="camera_mount_plate"
      pos="0 -0.9 0.663175"
      euler="0 0 1.5707963267948966"
      gravcomp="1"
    >
      <geom
        name="camera_mount_plate_geom"
        type="box"
        size="0.0889 0.01905 0.003175"
        material="pole_material"
        group="2"
      />
      <site
        name="camera_mount_plate_tf"
        pos="0 0 0"
        size="0.01"
        rgba="1 0 0 0.35"
      />
    </body>

    <!-- Shelving, tote and fixed cameras at their calibrated poses: generated at build time,
         see design_docs/board_based_calibration.md. -->
    <include file="assets/calibrated_scene.xml" />

    <site
      name="overview_camera_optical_frame"
      pos="-2.660 -0.826 1.172"
      xyaxes="0.335 -0.942 -0.000 -0.295 -0.105 -0.950"
    />
    <!-- `user="1"` is MuJoCo's per-camera userdata array (slot count set by
         `<size nuser_cam="1"/>` in robot_description.xml). picknik_mujoco_ros
         reserves slot 0 = depth_type: 0 = RGB_DEPTH (default), 1 = RGB_ONLY.
         Set to 1 here so this monitor-only third-person view skips depth +
         point-cloud rendering. -->
    <camera
      name="overview_camera"
      pos="-2.660 -0.826 1.172"
      fovy="30"
      mode="fixed"
      resolution="1280 960"
      xyaxes="0.335 -0.942 -0.000 0.295 0.105 0.950"
      user="1"
    />
  </worldbody>
</sim_additions>
