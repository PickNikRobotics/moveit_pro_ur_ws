<?xml version="1.0" ?>
<package format="3">
  <name>picknik_009_ur5e_config_sim</name>
  <version>0.8.0</version>

  <description>
    Simulation config for Dev-009 UR-5e + EPick gripper (fake hardware)
  </description>

  <maintainer email="support@picknik.ai">Henning Kayser</maintainer>

  <license>Proprietary</license>
  <!-- mjcf/assets/ur5e_visual (mujoco_menagerie); see NOTICE. -->
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>ur_robot_driver</exec_depend>

  <depend>picknik_009_ur5e_config</depend>
  <!-- adapters/epick Objective library (the suction-only Objectives). -->
  <exec_depend>shelf_stocking_objectives</exec_depend>
  <!-- package:// meshes loaded by mjcf/assets/robot_description.xml. -->
  <exec_depend>ur_description</exec_depend>
  <exec_depend>robotiq_description</exec_depend>
  <exec_depend>epick_description</exec_depend>
  <build_depend>python3-yaml</build_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_clang_format</test_depend>
  <test_depend>ament_clang_tidy</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
