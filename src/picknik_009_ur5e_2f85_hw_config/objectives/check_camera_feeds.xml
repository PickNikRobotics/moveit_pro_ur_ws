<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Check Camera Feeds">
  <BehaviorTree
    ID="Check Camera Feeds"
    _description="Checks that the replacement scene D415 and wrist Orbbec deliver fresh color frames before running camera calibration."
    _favorite="false"
  >
    <Control ID="Sequence" name="TopLevelSequence">
      <Control ID="Fallback" name="CheckSceneCamera">
        <Action
          ID="GetImage"
          name="GetSceneCameraFrame"
          topic_name="/camera/scene_camera/color/image_raw"
          message_timeout_sec="{message_timeout_sec}"
          publisher_timeout_sec="{message_timeout_sec}"
          message_out="{camera_check_image}"
        />
        <Control ID="Sequence">
          <Action
            ID="LogMessage"
            log_level="error"
            message="Camera check: scene_camera delivered no frame. Check the replacement D415 and restart the drivers."
          />
          <Action ID="AlwaysFailure" />
        </Control>
      </Control>
      <Control ID="Fallback" name="CheckWristOrbbec">
        <Action
          ID="GetImage"
          name="GetWristOrbbecFrame"
          topic_name="/camera/wrist_orbbec/color/image_raw"
          message_timeout_sec="{message_timeout_sec}"
          publisher_timeout_sec="{message_timeout_sec}"
          message_out="{camera_check_image}"
        />
        <Control ID="Sequence">
          <Action
            ID="LogMessage"
            log_level="error"
            message="Camera check: wrist_orbbec delivered no frame. Check the Orbbec driver and host udev access."
          />
          <Action ID="AlwaysFailure" />
        </Control>
      </Control>
      <Control ID="Fallback" name="CheckWristOrbbecCloud">
        <Action
          ID="GetPointCloud"
          name="GetWristOrbbecPointCloud"
          topic_name="/camera/wrist_orbbec/depth_registered/points"
          message_timeout_sec="{message_timeout_sec}"
          publisher_timeout_sec="{message_timeout_sec}"
          message_out="{camera_check_cloud}"
        />
        <Control ID="Sequence">
          <Action
            ID="LogMessage"
            log_level="error"
            message="Camera check: wrist_orbbec delivered no registered point cloud. Confirm RGB-D mode is enabled and dual-color mode is disabled."
          />
          <Action ID="AlwaysFailure" />
        </Control>
      </Control>
      <Action
        ID="LogMessage"
        log_level="info"
        message="Camera check: scene_camera and wrist_orbbec deliver fresh color frames, and the wrist Orbbec point cloud is available."
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Check Camera Feeds">
      <MetadataFields>
        <Metadata subcategory="3. Calibration Routine" />
        <Metadata runnable="true" />
      </MetadataFields>
      <input_port name="message_timeout_sec" default="3.0" type="double">
        Seconds to wait for each camera's next color frame and topic advertisement.
      </input_port>
    </SubTree>
  </TreeNodesModel>
</root>
