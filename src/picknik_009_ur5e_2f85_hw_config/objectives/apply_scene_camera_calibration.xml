<?xml version="1.0" encoding="UTF-8" ?>
<root
  BTCPP_format="4"
  main_tree_to_execute="Apply Scene Camera Calibration"
>
  <BehaviorTree
    ID="Apply Scene Camera Calibration"
    _description="Copies the reviewed replacement scene D415 pose candidate into scene_camera_link, which Load Calibrated Scene and the hardware launch use. Restart the stack after applying."
    _favorite="false"
  >
    <Control ID="Sequence" name="TopLevelSequence">
      <Action
        ID="LoadPoseStampedFromYamlNamespace"
        file_path="~/user_ws/src/picknik_009_ur5e_config/objectives/calibration/cell_calibration.yaml"
        namespace="{candidate_section}"
        output="{scene_camera_pose}"
      />
      <Action
        ID="SavePoseStampedToYaml"
        yaml_filename="~/user_ws/src/picknik_009_ur5e_config/objectives/calibration/cell_calibration.yaml"
        namespace="scene_camera_link"
        overwrite="false"
        message="{scene_camera_pose}"
      />
      <Action
        ID="LogMessage"
        log_level="info"
        message="Applied scene_camera_link. Restart the stack before using the calibrated scene camera."
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Apply Scene Camera Calibration">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="3. Calibration Routine" />
      </MetadataFields>
      <input_port name="candidate_section" default="scene_camera_link_candidate_shelf_board" type="std::string">
        Reviewed cell_calibration.yaml section containing scene_camera_link in world.
      </input_port>
    </SubTree>
  </TreeNodesModel>
</root>
