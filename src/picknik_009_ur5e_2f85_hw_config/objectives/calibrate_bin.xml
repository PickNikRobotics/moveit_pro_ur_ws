<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Calibrate Bin">
  <BehaviorTree
    ID="Calibrate Bin"
    _description="Measure the 2F-85 drop bin in place: close the fingers on the bin's front-left outside corner (left side, robot-facing edge), click Continue to record the fingertip pose in world, and save it as calibrated_bin_front_left_corner in cell_calibration.yaml. Load Calibrated Scene uses that measurement to place the open, world-aligned bin."
    _favorite="false"
  >
    <Control ID="Sequence" name="TopLevelSequence">
      <SubTree
        ID="Close Gripper"
        _collapsed="true"
      />
      <SubTree
        ID="Request Teleoperation"
        _collapsed="true"
        enable_user_interaction="true"
        user_interaction_prompt="First select joint jog in the MoveIt Pro UI, then jog the closed left fingertip to the bin's front-left outside corner: the left side, robot-facing edge (world +X, +Y). Place the left fingertip against the outside corner without pressing, then click Continue to save. Abort cancels calibration."
        controller_action_server="/joint_trajectory_admittance_controller/follow_joint_trajectory"
        joint_trajectory_controller_name="joint_trajectory_admittance_controller"
        default_planning_group="manipulator"
        default_ik_frame="grasp_link"
        link_padding="0.01"
        execution_pipeline="jtac"
        velocity_scale_factor="0.15"
        max_ik_solutions="8"
        max_mtc_solutions="1"
        initial_teleop_mode="3"
        require_user_approval="false"
      />
      <Action
        ID="CreatePoseStamped"
        name="CaptureLeftFingerTipAtFrontLeftCorner"
        reference_frame="robotiq_85_left_finger_tip_link"
        position_xyz="0;0;0"
        orientation_xyzw="0;0;0;1"
        pose_stamped="{bin_front_left_corner_fingertip}"
      />
      <Action
        ID="TransformPoseFrame"
        name="TransformBinCornerToWorld"
        input_pose="{bin_front_left_corner_fingertip}"
        target_frame_id="world"
        output_pose="{bin_front_left_corner_fingertip_world}"
      />
      <Action
        ID="SavePoseStampedToYaml"
        yaml_filename="~/user_ws/src/picknik_009_ur5e_config/objectives/calibration/cell_calibration.yaml"
        namespace="calibrated_bin_front_left_corner"
        overwrite="false"
        message="{bin_front_left_corner_fingertip_world}"
      />
      <SubTree
        ID="Load Calibrated Scene"
        top_shelf_pose="{top_shelf_pose}"
        bottom_shelf_pose="{bottom_shelf_pose}"
        bin_calibrated_pose="{bin_calibrated_pose}"
      />
      <Action
        ID="LogMessage"
        log_level="info"
        message="Saved calibrated_bin_front_left_corner and loaded the workcell with the bin in the MoveIt Pro 3D Visualizer. Re-run Calibrate Bin whenever the physical bin moves."
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Calibrate Bin">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="3. Calibration Routine" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>
