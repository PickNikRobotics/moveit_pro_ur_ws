<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Load Calibrated Scene">
  <!--
    2F-85 copy of picknik_009_ur5e_config's Load Calibrated Scene: this file's library
    (x4_2f85_objectives) sorts after the base one, so it wins on this config only. The tote
    is replaced by a four-wall bin whose pose comes from Calibrate Bin. Calibrated Bag
    shares that pose and the bin's interior dimensions with the existing 2F-85 drop logic.
    Two open-top paper bags stand inside the bin, placed from the same calibrated pose.
    The 80/20 workcell is gone from this cell, so it is not added (only removed, to clear
    a scene loaded earlier). Keep the remaining shared scene in step with the base file.
  -->
  <BehaviorTree
    ID="Load Calibrated Scene"
    _description="2F-85 version: loads the bin measured by Calibrate Bin with its two paper bags (bag_side blocks off the one not in use), plus the calibrated shelving, the table and the fixed 2F-85 cell parts. The bin pose comes from the calibrated_bin section of cell_calibration.yaml; Calibrated Bag exposes the same pose and interior dimensions to the existing 2F-85 drop logic. Publishes the scene-camera transform. Calibrate the bin before using this scene. See design_docs/calibrate_bin.md and design_docs/board_based_calibration.md."
    _favorite="false"
  >
    <Control ID="Sequence" name="TopLevelSequence" _collapsed="false">
      <!--=== CLEANUP any previous calibration objects ===-->
      <Decorator ID="ForceSuccess" _collapsed="false">
        <Action ID="RemoveURDFFromScene" urdf_name="calibrated_top_shelf" />
      </Decorator>
      <Decorator ID="ForceSuccess" _collapsed="false">
        <Action ID="RemoveURDFFromScene" urdf_name="calibrated_bottom_shelf" />
      </Decorator>
      <Decorator ID="ForceSuccess" _collapsed="false">
        <Action ID="RemoveURDFFromScene" urdf_name="calibrated_middle_shelf" />
      </Decorator>
      <Decorator ID="ForceSuccess" _collapsed="false">
        <Action ID="RemoveCollisionObject" object_id="top_shelf_inflation_front" />
      </Decorator>
      <Decorator ID="ForceSuccess" _collapsed="false">
        <Action ID="RemoveCollisionObject" object_id="top_shelf_inflation_bottom" />
      </Decorator>
      <Decorator ID="ForceSuccess" _collapsed="false">
        <Action ID="RemoveCollisionObject" object_id="middle_shelf_inflation_front" />
      </Decorator>
      <Decorator ID="ForceSuccess" _collapsed="false">
        <Action ID="RemoveCollisionObject" object_id="middle_shelf_inflation_bottom" />
      </Decorator>
      <Decorator ID="ForceSuccess" _collapsed="false">
        <Action ID="RemoveCollisionObject" object_id="bottom_shelf_inflation_front" />
      </Decorator>
      <Decorator ID="ForceSuccess" _collapsed="false">
        <Action ID="RemoveCollisionObject" object_id="bottom_shelf_inflation_bottom" />
      </Decorator>
      <Decorator ID="ForceSuccess" _collapsed="false">
        <Action ID="RemoveCollisionObject" object_id="bottom_rack_keepout" />
      </Decorator>
      <Decorator ID="ForceSuccess" _collapsed="false">
        <Action ID="RemoveURDFFromScene" urdf_name="calibrated_bin" />
      </Decorator>
      <Decorator ID="ForceSuccess" _collapsed="false">
        <Action ID="RemoveCollisionObject" object_id="calibrated_bag_wall_px" />
      </Decorator>
      <Decorator ID="ForceSuccess" _collapsed="false">
        <Action ID="RemoveCollisionObject" object_id="calibrated_bag_wall_nx" />
      </Decorator>
      <Decorator ID="ForceSuccess" _collapsed="false">
        <Action ID="RemoveCollisionObject" object_id="calibrated_bag_wall_py" />
      </Decorator>
      <Decorator ID="ForceSuccess" _collapsed="false">
        <Action ID="RemoveCollisionObject" object_id="calibrated_bag_wall_ny" />
      </Decorator>
      <Decorator ID="ForceSuccess" _collapsed="false">
        <Action ID="RemoveCollisionObject" object_id="paper_bag_px_wall_px" />
      </Decorator>
      <Decorator ID="ForceSuccess" _collapsed="false">
        <Action ID="RemoveCollisionObject" object_id="paper_bag_px_wall_nx" />
      </Decorator>
      <Decorator ID="ForceSuccess" _collapsed="false">
        <Action ID="RemoveCollisionObject" object_id="paper_bag_px_wall_py" />
      </Decorator>
      <Decorator ID="ForceSuccess" _collapsed="false">
        <Action ID="RemoveCollisionObject" object_id="paper_bag_px_wall_ny" />
      </Decorator>
      <Decorator ID="ForceSuccess" _collapsed="false">
        <Action ID="RemoveCollisionObject" object_id="paper_bag_nx_wall_px" />
      </Decorator>
      <Decorator ID="ForceSuccess" _collapsed="false">
        <Action ID="RemoveCollisionObject" object_id="paper_bag_nx_wall_nx" />
      </Decorator>
      <Decorator ID="ForceSuccess" _collapsed="false">
        <Action ID="RemoveCollisionObject" object_id="paper_bag_nx_wall_py" />
      </Decorator>
      <Decorator ID="ForceSuccess" _collapsed="false">
        <Action ID="RemoveCollisionObject" object_id="paper_bag_nx_wall_ny" />
      </Decorator>
      <Decorator ID="ForceSuccess" _collapsed="false">
        <Action ID="RemoveCollisionObject" object_id="paper_bag_px_blocked" />
      </Decorator>
      <Decorator ID="ForceSuccess" _collapsed="false">
        <Action ID="RemoveCollisionObject" object_id="paper_bag_nx_blocked" />
      </Decorator>
      <Decorator ID="ForceSuccess" _collapsed="false">
        <Action ID="RemoveCollisionObject" object_id="camera_mount_plate" />
      </Decorator>
      <Decorator ID="ForceSuccess" _collapsed="false">
        <Action ID="RemoveURDFFromScene" urdf_name="calibrated_camera" />
      </Decorator>
      <Decorator ID="ForceSuccess" _collapsed="false">
        <Action ID="RemoveURDFFromScene" urdf_name="calibrated_workcell" />
      </Decorator>
      <Decorator ID="ForceSuccess" _collapsed="false">
        <Action ID="RemoveCollisionObject" object_id="camera_pole_mount_plate" />
      </Decorator>
      <!--Clear the obsolete shelf-camera support from any scene loaded before this override. -->
      <Decorator ID="ForceSuccess" _collapsed="false">
        <Action ID="RemoveCollisionObject" object_id="vla_cam_rig_post" />
      </Decorator>
      <Decorator ID="ForceSuccess" _collapsed="false">
        <Action ID="RemoveCollisionObject" object_id="vla_cam_rig_crossbar" />
      </Decorator>
      <Decorator ID="ForceSuccess" _collapsed="false">
        <Action ID="RemoveCollisionObject" object_id="vla_cam_rig_clamp" />
      </Decorator>
      <!--=== WORK OUT THE SHELVING FROM THE WALL BOARD AND THE OFFSETS ===-->
      <Action
        ID="LoadPoseStampedFromYamlNamespace"
        file_path="~/user_ws/src/picknik_009_ur5e_config/objectives/calibration/cell_calibration.yaml"
        namespace="wall_board"
        output="{wall_board_pose}"
      />
      <SubTree
        ID="Place Shelving From Wall Board"
        _collapsed="true"
        wall_board_pose="{wall_board_pose}"
        shelf_back_pose="{shelf_back_pose}"
        top_shelf_pose="{top_shelf_pose}"
        bottom_shelf_pose="{bottom_shelf_pose}"
        middle_shelf_pose="{middle_shelf_pose}"
        shelf_base_pose="{shelf_base_pose}"
      />
      <!--=== PLACE TOP SHELF ===-->
      <Action
        ID="AddURDF"
        urdf_name="calibrated_top_shelf"
        urdf_pose="{top_shelf_pose}"
        package_name="picknik_009_ur5e_config"
        urdf_file_path="description/chunky_shelf_only.urdf"
      />
      <Action
        ID="VisualizePose"
        marker_lifetime="0.000000"
        marker_name="top_shelf_center"
        marker_size="0.100000"
        pose="{top_shelf_pose}"
        marker_text="Top Shelf"
      />
      <!--=== PLACE BOTTOM SHELF ===-->
      <Action
        ID="AddURDF"
        urdf_name="calibrated_bottom_shelf"
        urdf_pose="{bottom_shelf_pose}"
        package_name="picknik_009_ur5e_config"
        urdf_file_path="description/chunky_shelf_only.urdf"
      />
      <Action
        ID="VisualizePose"
        marker_lifetime="0.000000"
        marker_name="bottom_shelf_center"
        marker_size="0.100000"
        pose="{bottom_shelf_pose}"
        marker_text="Bottom Shelf"
      />
      <!--=== PLACE MIDDLE SHELF (added 2026-11-16, between the top and bottom) ===-->
      <Action
        ID="AddURDF"
        urdf_name="calibrated_middle_shelf"
        urdf_pose="{middle_shelf_pose}"
        package_name="picknik_009_ur5e_config"
        urdf_file_path="description/chunky_shelf_only.urdf"
      />
      <Action
        ID="VisualizePose"
        marker_lifetime="0.000000"
        marker_name="middle_shelf_center"
        marker_size="0.100000"
        pose="{middle_shelf_pose}"
        marker_text="Middle Shelf"
      />
      <!--=== INFLATE EVERY RACK 1 CM ON THE FRONT AND UNDERNEATH ===-->
      <!--The arm kept clipping the middle rack. chunky_shelf_only is a wedge in its own
          frame: top surface at z 0 back to the wall (y -0.4254), a 31.8 mm front lip whose
          face is at y +0.0254 (towards the robot), and an underside sloping from the lip's
          bottom (y 0.0254, z -0.0318) down to z -0.1083 at the wall. Two 1 cm slabs per rack,
          placed in the rack's frame so they follow calibration: one on the lip's face, down
          to 1 cm below it, and one under the sloped underside (9.63 degrees about x). Nothing
          is added above the top surface, so products and approaches over the board are
          unchanged. The slab sizes and offsets come from the mesh; change both if the mesh
          or the 1 cm changes.-->
      <Action
        ID="TransformPose"
        name="TopShelfFrontInflationPose"
        input_pose="{top_shelf_pose}"
        translation_xyz="0;0.0304;-0.0209"
        quaternion_xyzw="0;0;0;1"
        output_pose="{shelf_inflation_pose}"
      />
      <Action
        ID="AddCollisionBox"
        name="AddTopShelfFrontInflation"
        object_id="top_shelf_inflation_front"
        dimensions="1.2192;0.01;0.0418"
        pose="{shelf_inflation_pose}"
        overwrite="true"
      />
      <Action
        ID="TransformPose"
        name="TopShelfBottomInflationPose"
        input_pose="{top_shelf_pose}"
        translation_xyz="0;-0.19916;-0.07498"
        quaternion_xyzw="0.08395;0;0;0.99647"
        output_pose="{shelf_inflation_pose}"
      />
      <Action
        ID="AddCollisionBox"
        name="AddTopShelfBottomInflation"
        object_id="top_shelf_inflation_bottom"
        dimensions="1.2192;0.4572;0.01"
        pose="{shelf_inflation_pose}"
        overwrite="true"
      />
      <Action
        ID="TransformPose"
        name="MiddleShelfFrontInflationPose"
        input_pose="{middle_shelf_pose}"
        translation_xyz="0;0.0304;-0.0209"
        quaternion_xyzw="0;0;0;1"
        output_pose="{shelf_inflation_pose}"
      />
      <Action
        ID="AddCollisionBox"
        name="AddMiddleShelfFrontInflation"
        object_id="middle_shelf_inflation_front"
        dimensions="1.2192;0.01;0.0418"
        pose="{shelf_inflation_pose}"
        overwrite="true"
      />
      <Action
        ID="TransformPose"
        name="MiddleShelfBottomInflationPose"
        input_pose="{middle_shelf_pose}"
        translation_xyz="0;-0.19916;-0.07498"
        quaternion_xyzw="0.08395;0;0;0.99647"
        output_pose="{shelf_inflation_pose}"
      />
      <Action
        ID="AddCollisionBox"
        name="AddMiddleShelfBottomInflation"
        object_id="middle_shelf_inflation_bottom"
        dimensions="1.2192;0.4572;0.01"
        pose="{shelf_inflation_pose}"
        overwrite="true"
      />
      <Action
        ID="TransformPose"
        name="BottomShelfFrontInflationPose"
        input_pose="{bottom_shelf_pose}"
        translation_xyz="0;0.0304;-0.0209"
        quaternion_xyzw="0;0;0;1"
        output_pose="{shelf_inflation_pose}"
      />
      <Action
        ID="AddCollisionBox"
        name="AddBottomShelfFrontInflation"
        object_id="bottom_shelf_inflation_front"
        dimensions="1.2192;0.01;0.0418"
        pose="{shelf_inflation_pose}"
        overwrite="true"
      />
      <Action
        ID="TransformPose"
        name="BottomShelfBottomInflationPose"
        input_pose="{bottom_shelf_pose}"
        translation_xyz="0;-0.19916;-0.07498"
        quaternion_xyzw="0.08395;0;0;0.99647"
        output_pose="{shelf_inflation_pose}"
      />
      <Action
        ID="AddCollisionBox"
        name="AddBottomShelfBottomInflation"
        object_id="bottom_shelf_inflation_bottom"
        dimensions="1.2192;0.4572;0.01"
        pose="{shelf_inflation_pose}"
        overwrite="true"
      />
      <!--=== KEEP OUT OF THE BOTTOM RACK ===-->
      <!--Nothing is picked from the bottom rack on this cell. One box fills the opening
          under the middle rack, in the bottom rack's frame: the full rack length, from the
          wall (y -0.4254) to the front face of the lip's 1 cm inflation (y +0.0354), and
          from the bottom board's top surface up to the bottom of the middle rack's front
          inflation (lip 31.8 mm + 1 cm below its top surface). The height is the two
          racks' calibrated spacing, so it follows a re-measured middle or bottom rack. A
          grasp worked out on the bottom board, including a middle-rack product that Plan
          Shelf Pick sorted onto the bottom rack from a low cloud centroid, then fails to
          plan and the next candidate is tried.-->
      <Action
        ID="CalculatePoseOffset"
        name="MiddleRackInBottomRack"
        source_pose="{bottom_shelf_pose}"
        destination_pose="{middle_shelf_pose}"
        source_to_destination_pose="{middle_in_bottom_rack}"
      />
      <Action
        ID="UnpackPoseStampedMessage"
        pose_stamped="{middle_in_bottom_rack}"
        pose="{middle_in_bottom_rack_pose}"
        header="{middle_in_bottom_rack_header}"
      />
      <Action
        ID="UnpackPoseMessage"
        pose="{middle_in_bottom_rack_pose}"
        position="{middle_in_bottom_rack_position}"
        orientation="{middle_in_bottom_rack_orientation}"
      />
      <Action
        ID="UnpackPointMessage"
        point="{middle_in_bottom_rack_position}"
        x="{middle_in_bottom_rack_x}"
        y="{middle_in_bottom_rack_y}"
        z="{rack_spacing}"
      />
      <Action
        ID="Script"
        name="BottomRackKeepoutSize"
        code="keepout_h := rack_spacing - 0.0418; keepout_cz := keepout_h / 2.0; keepout_h_s := keepout_h .. ''; keepout_cz_s := keepout_cz .. ''; bottom_rack_keepout_dims := '1.2192;0.4608;' .. keepout_h_s; bottom_rack_keepout_xyz := '0;-0.195;' .. keepout_cz_s"
      />
      <Action
        ID="TransformPose"
        name="BottomRackKeepoutPose"
        input_pose="{bottom_shelf_pose}"
        translation_xyz="{bottom_rack_keepout_xyz}"
        quaternion_xyzw="0;0;0;1"
        output_pose="{bottom_rack_keepout_pose}"
      />
      <Action
        ID="AddCollisionBox"
        name="AddBottomRackKeepout"
        object_id="bottom_rack_keepout"
        dimensions="{bottom_rack_keepout_dims}"
        pose="{bottom_rack_keepout_pose}"
        overwrite="true"
      />
      <!--=== PLACE SHELF BACK BOX ===-->
      <!--1.27m wide, 0.08m deep, 72" (1.8288m) tall-->
      <!--AddCollisionBox (MoveIt Pro 10.0) builds the box and applies it to the
          live scene in one step, replacing the CreateSolidPrimitiveBox +
          CreateCollisionObjectFromSolidPrimitive + Convert To GraspableObject +
          AddVirtualObjectToPlanningScene chain (all removed in 10.0).-->
      <Action
        ID="AddCollisionBox"
        object_id="shelf_back"
        dimensions="1.27;0.08;1.8288"
        pose="{shelf_back_pose}"
        overwrite="true"
      />
      <!--=== PLACE SHELF BASE BOX ===-->
      <!--1.27m wide, 0.48m deep, 0.20m tall-->
      <Action
        ID="AddCollisionBox"
        object_id="shelf_base"
        dimensions="1.27;0.48;0.20"
        pose="{shelf_base_pose}"
        overwrite="true"
      />
      <!--=== PLACE TABLE (offset back from the robot in -Y, centered in X) ===-->
      <!--Table is 1.24m wide (X), 0.63m deep (Y), 0.76m tall (Z). The table sits
          in front of the robot (-Y), centered in X, top flush with the robot
          base in Z. Y position offsets the front edge 0.34 m back from the
          robot origin (front edge y = -0.34, center y = -0.655), to give
          clearance from the shelves on the +Y side. Not calibrated; this is a
          fixed assumption of the workcell.-->
      <Action
        ID="CreatePoseStamped"
        reference_frame="world"
        position_xyz="0;-0.655;-0.38"
        orientation_xyzw="0;0;0;1"
        pose_stamped="{table_calibrated_pose}"
      />
      <Action
        ID="AddCollisionBox"
        object_id="calibrated_table"
        dimensions="1.24;0.63;0.76"
        pose="{table_calibrated_pose}"
        overwrite="true"
      />
      <!--=== PLACE THE 2F-85 STAND-CORNER 80/20 POLE ===-->
      <!--Touch-off placement from the actual fingertip frames, not grasp_link.
          The first fingertip-based estimate still overlapped the physical tips;
          after checking against the real 3.5 cm finger reach, shift the pole
          3.5 cm away from the robot (-world Y). The 2F-85 points approximately
          along world -Y here. Vertically, the stand mesh's lowest point is the
          floor reference. Fixed 2F-85 hardware assumption only.
          2026-11-17: the pole and scene camera moved to the robot's right. X is
          the touched-off -X position mirrored about the robot base (the stand is
          symmetric in X); not touched off again. The right-side post is shorter,
          1.08 m from the floor: the bottom stays on the floor reference and the
          centre is half the height above it. -->
      <Action
        ID="CreatePoseStamped"
        reference_frame="world"
        position_xyz="0.269;-0.3545;-0.265"
        orientation_xyzw="0;0;0;1"
        pose_stamped="{robot_stand_corner_pole_pose}"
      />
      <Action
        ID="AddCollisionBox"
        object_id="robot_stand_corner_pole"
        dimensions="0.04;0.04;1.08"
        pose="{robot_stand_corner_pole_pose}"
        overwrite="true"
      />
      <!--=== ADD THE CAMERA MOUNT PLATE ON THE POLE, PROJECTING +X ===-->
      <!--The plate is screwed to the pole's +Y face (toward the robot) and projects
          outward along world +X, away from the robot. Its 7-inch dimension runs along
          X, with its -X edge on the pole's -X edge. Its top edge is level with the top
          of the post, so its centre is half its height below the post top; its thin
          dimension lies along world Y. -->
      <Action
        ID="CreatePoseStamped"
        reference_frame="world"
        position_xyz="0.338;-0.331325;0.252775"
        orientation_xyzw="0;0;-0.7071068;0.7071068"
        pose_stamped="{camera_pole_mount_plate_pose}"
      />
      <Action
        ID="AddCollisionBox"
        object_id="camera_pole_mount_plate"
        dimensions="0.00635;0.1778;0.04445"
        pose="{camera_pole_mount_plate_pose}"
        overwrite="true"
      />
      <!--=== ADD THE CALIBRATED BIN (2F-85) ===-->
      <!--Calibrated Bag reads the top-left corner captured by Calibrate Bin and derives
          the world-aligned bin centre and interior dimensions, shared with the existing
          2F-85 drop logic. The tabletop is the bin floor; the bin has an open top and thin
          walls. See design_docs/calibrate_bin.md. -->
      <Control ID="Sequence" name="AddBin">
        <SubTree
          ID="Calibrated Bag"
          bag_side="{bag_side}"
          bag_pose="{drop_container_pose}"
          bag_length="{drop_container_length}"
          bag_width="{drop_container_width}"
          bag_height="{drop_container_height}"
          bag_floor_z="{drop_container_floor_z}"
          bin_pose="{bin_calibrated_pose}"
          bin_length="{bin_length}"
          bin_width="{bin_width}"
          bin_height="{bin_height}"
          paper_bag_width="{paper_bag_width}"
          paper_bag_height="{paper_bag_height}"
          paper_wall="{paper_wall}"
          paper_bag_cx="{paper_bag_cx}"
        />
        <Action
          ID="Script"
          name="BagWallGeometry"
          code="t := 0.00635; ox := bin_length / 2.0 + t / 2.0; oy := bin_width / 2.0 + t / 2.0; long_wall := bin_length + 2.0 * t; nox := 0.0 - ox; noy := 0.0 - oy; ox_s := ox .. ''; nox_s := nox .. ''; oy_s := oy .. ''; noy_s := noy .. ''; t_s := t .. ''; lw_s := long_wall .. ''; w_s := bin_width .. ''; h_s := bin_height .. ''; wall_px_xyz := ox_s .. ';0;0'; wall_nx_xyz := nox_s .. ';0;0'; wall_py_xyz := '0;' .. oy_s .. ';0'; wall_ny_xyz := '0;' .. noy_s .. ';0'; wall_x_dims := t_s .. ';' .. w_s .. ';' .. h_s; wall_y_dims := lw_s .. ';' .. t_s .. ';' .. h_s"
        />
        <Action
          ID="CreatePoseStamped"
          name="BagWallOffset_px"
          reference_frame="world"
          position_xyz="{wall_px_xyz}"
          orientation_xyzw="0;0;0;1"
          pose_stamped="{bag_wall_offset}"
        />
        <Action
          ID="TransformPoseWithPose"
          name="BagWallPose_px"
          input_pose="{bag_wall_offset}"
          transform_pose="{bin_calibrated_pose}"
          output_pose="{bag_wall_pose}"
        />
        <Action
          ID="AddCollisionBox"
          name="AddBagWall_px"
          object_id="calibrated_bag_wall_px"
          dimensions="{wall_x_dims}"
          pose="{bag_wall_pose}"
          overwrite="true"
        />
        <Action
          ID="CreatePoseStamped"
          name="BagWallOffset_nx"
          reference_frame="world"
          position_xyz="{wall_nx_xyz}"
          orientation_xyzw="0;0;0;1"
          pose_stamped="{bag_wall_offset}"
        />
        <Action
          ID="TransformPoseWithPose"
          name="BagWallPose_nx"
          input_pose="{bag_wall_offset}"
          transform_pose="{bin_calibrated_pose}"
          output_pose="{bag_wall_pose}"
        />
        <Action
          ID="AddCollisionBox"
          name="AddBagWall_nx"
          object_id="calibrated_bag_wall_nx"
          dimensions="{wall_x_dims}"
          pose="{bag_wall_pose}"
          overwrite="true"
        />
        <Action
          ID="CreatePoseStamped"
          name="BagWallOffset_py"
          reference_frame="world"
          position_xyz="{wall_py_xyz}"
          orientation_xyzw="0;0;0;1"
          pose_stamped="{bag_wall_offset}"
        />
        <Action
          ID="TransformPoseWithPose"
          name="BagWallPose_py"
          input_pose="{bag_wall_offset}"
          transform_pose="{bin_calibrated_pose}"
          output_pose="{bag_wall_pose}"
        />
        <Action
          ID="AddCollisionBox"
          name="AddBagWall_py"
          object_id="calibrated_bag_wall_py"
          dimensions="{wall_y_dims}"
          pose="{bag_wall_pose}"
          overwrite="true"
        />
        <Action
          ID="CreatePoseStamped"
          name="BagWallOffset_ny"
          reference_frame="world"
          position_xyz="{wall_ny_xyz}"
          orientation_xyzw="0;0;0;1"
          pose_stamped="{bag_wall_offset}"
        />
        <Action
          ID="TransformPoseWithPose"
          name="BagWallPose_ny"
          input_pose="{bag_wall_offset}"
          transform_pose="{bin_calibrated_pose}"
          output_pose="{bag_wall_pose}"
        />
        <Action
          ID="AddCollisionBox"
          name="AddBagWall_ny"
          object_id="calibrated_bag_wall_ny"
          dimensions="{wall_y_dims}"
          pose="{bag_wall_pose}"
          overwrite="true"
        />
        <!--Two paper bags, one against each X wall of the bin, spanning its full depth,
            with the rest of the bin between them. Open-topped, so products can still be
            lowered into them. See design_docs/calibrate_bin.md.-->
        <Action
          ID="Script"
          name="RightPaperBagOffset"
          code="paper_bag_ncx := 0.0 - paper_bag_cx"
        />
        <SubTree
          ID="Add Calibrated Paper Bag"
          name="AddPaperBag_px"
          bin_pose="{bin_calibrated_pose}"
          bag_center_x="{paper_bag_cx}"
          bin_width="{bin_width}"
          bin_height="{bin_height}"
          paper_bag_width="{paper_bag_width}"
          paper_bag_height="{paper_bag_height}"
          paper_wall="{paper_wall}"
          bag_id="paper_bag_px"
        />
        <SubTree
          ID="Add Calibrated Paper Bag"
          name="AddPaperBag_nx"
          bin_pose="{bin_calibrated_pose}"
          bag_center_x="{paper_bag_ncx}"
          bin_width="{bin_width}"
          bin_height="{bin_height}"
          paper_bag_width="{paper_bag_width}"
          paper_bag_height="{paper_bag_height}"
          paper_wall="{paper_wall}"
          bag_id="paper_bag_nx"
        />
        <!--bag_side left or right: fill the other bag with a solid box so nothing is
            planned into it. bin leaves both open.-->
        <Action
          ID="Script"
          name="UnusedPaperBagGeometry"
          code="ub_cz := paper_bag_height / 2.0 - bin_height / 2.0; ub_cz_s := ub_cz .. ''; ub_px_s := paper_bag_cx .. ''; ub_nx_s := paper_bag_ncx .. ''; blocked_px_xyz := ub_px_s .. ';0;' .. ub_cz_s; blocked_nx_xyz := ub_nx_s .. ';0;' .. ub_cz_s; ub_w_s := paper_bag_width .. ''; ub_d_s := bin_width .. ''; ub_h_s := paper_bag_height .. ''; blocked_dims := ub_w_s .. ';' .. ub_d_s .. ';' .. ub_h_s"
        />
        <Decorator ID="Precondition" name="IfLeftBagBlockRight" if="bag_side == 'left'" else="SUCCESS">
          <Control ID="Sequence" name="BlockRightPaperBag">
            <Action
              ID="CreatePoseStamped"
              name="BlockedRightBagOffset"
              reference_frame="world"
              position_xyz="{blocked_nx_xyz}"
              orientation_xyzw="0;0;0;1"
              pose_stamped="{blocked_bag_offset}"
            />
            <Action
              ID="TransformPoseWithPose"
              name="BlockedRightBagPose"
              input_pose="{blocked_bag_offset}"
              transform_pose="{bin_calibrated_pose}"
              output_pose="{blocked_bag_pose}"
            />
            <Action
              ID="AddCollisionBox"
              name="AddBlockedRightBag"
              object_id="paper_bag_nx_blocked"
              dimensions="{blocked_dims}"
              pose="{blocked_bag_pose}"
              overwrite="true"
            />
          </Control>
        </Decorator>
        <Decorator ID="Precondition" name="IfRightBagBlockLeft" if="bag_side == 'right'" else="SUCCESS">
          <Control ID="Sequence" name="BlockLeftPaperBag">
            <Action
              ID="CreatePoseStamped"
              name="BlockedLeftBagOffset"
              reference_frame="world"
              position_xyz="{blocked_px_xyz}"
              orientation_xyzw="0;0;0;1"
              pose_stamped="{blocked_bag_offset}"
            />
            <Action
              ID="TransformPoseWithPose"
              name="BlockedLeftBagPose"
              input_pose="{blocked_bag_offset}"
              transform_pose="{bin_calibrated_pose}"
              output_pose="{blocked_bag_pose}"
            />
            <Action
              ID="AddCollisionBox"
              name="AddBlockedLeftBag"
              object_id="paper_bag_px_blocked"
              dimensions="{blocked_dims}"
              pose="{blocked_bag_pose}"
              overwrite="true"
            />
          </Control>
        </Decorator>
        <Action
          ID="VisualizePose"
          marker_lifetime="0.000000"
          marker_name="calibrated_bin_center"
          marker_size="0.100000"
          pose="{bin_calibrated_pose}"
          marker_text="Calibrated Bin"
        />
      </Control>
      <!--=== LOAD CALIBRATED SCENE CAMERA (from Calibrate Scene Camera From Shelf Board) ===-->
      <Action
        ID="LoadPoseStampedFromYamlNamespace"
        file_path="~/user_ws/src/picknik_009_ur5e_config/objectives/calibration/cell_calibration.yaml"
        namespace="scene_camera_link"
        output="{scene_camera_link_pose}"
      />
      <Action
        ID="AddURDF"
        urdf_name="calibrated_camera"
        urdf_pose="{scene_camera_link_pose}"
        package_name="picknik_009_ur5e_config"
        urdf_file_path="description/scene_camera.urdf"
      />
      <Action
        ID="PublishStaticTransform"
        pose="{scene_camera_link_pose}"
        child_frame_id="scene_camera_link"
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Load Calibrated Scene">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="3. Calibration Routine" />
      </MetadataFields>
      <output_port name="top_shelf_pose">
        Top-shelf reference pose, worked out from the wall board and the
        offsets. Map this at the call site.
      </output_port>
      <output_port name="bottom_shelf_pose">
        Bottom-shelf reference pose, worked out from the wall board and the
        offsets. Map this at the call site.
      </output_port>
      <input_port name="bag_side" default="bin" type="std::string">
        Which paper bag the drops go into: left or right (as seen from the robot; left is
        world +X) fills the other bag with a solid box; bin leaves both open.
      </input_port>
      <output_port name="bin_calibrated_pose">
        Calibrated bin reference pose in world, centred between the outer walls
        and halfway up from the table. The parent passes this through to the
        2F-85 drop logic, which reads matching interior dimensions from
        Calibrated Bag.
      </output_port>
    </SubTree>
  </TreeNodesModel>
</root>
