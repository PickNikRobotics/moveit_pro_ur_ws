<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Calibrated Bag">
  <!--
    Compatibility interface for the existing 2F-85 drop subtrees. The physical bin pose
    comes from Calibrate Bin and is passed into Load Calibrated Scene; this subtree owns only
    the fixed inside dimensions and exposes the runtime pose input together with the shared
    bag_* ports that Gentle Bag already consumes. The tabletop is the bin floor.
  -->
  <BehaviorTree
    ID="Calibrated Bag"
    _description="Compatibility adapter for 2F-85 drop subtrees: receives the calibrated bin pose and provides the shared interior dimensions used by Gentle Bag. Load Calibrated Scene adds the open bin walls."
    _favorite="false"
  >
    <Control ID="Sequence" name="TopLevelSequence">
      <Action
        ID="LoadPoseStampedFromYamlNamespace"
        name="LoadCalibratedBinFrontLeftCorner"
        file_path="~/user_ws/src/picknik_009_ur5e_config/objectives/calibration/cell_calibration.yaml"
        namespace="calibrated_bin_front_left_corner"
        output="{bin_front_left_corner_fingertip_pose}"
      />
      <!--The saved pose is the fingertip origin. Convert it to the actual touched outer
          contact point before removing orientation; the fingertips' collision mesh extends
          beyond TF. Close Gripper seats the contact pad against the bin's outside faces. -->
      <Action
        ID="CreatePoseStamped"
        name="TouchedFrontLeftCornerOffset"
        reference_frame="world"
        position_xyz="-0.025259;-0.0008;0.047015"
        orientation_xyzw="0;0;0;1"
        pose_stamped="{bin_front_left_corner_fingertip_local}"
      />
      <Action
        ID="TransformPose"
        name="FingertipToFrontLeftCorner"
        input_pose="{bin_front_left_corner_fingertip_pose}"
        translation_xyz="-0.025259;-0.0008;0.047015"
        quaternion_xyzw="0;0;0;1"
        output_pose="{bin_front_left_corner_pose}"
      />
      <Action
        ID="OverridePoseOrientation"
        name="SquareBinToWorld"
        input_pose="{bin_front_left_corner_pose}"
        orientation_xyzw="0;0;0;1"
        output_pose="{bin_front_left_corner_world_aligned}"
      />
      <Action
        ID="TransformPose"
        name="BinCenterFromFrontLeftCorner"
        input_pose="{bin_front_left_corner_world_aligned}"
        translation_xyz="-0.2286;-0.1651;-0.1397"
        quaternion_xyzw="0;0;0;1"
        output_pose="{bag_pose}"
      />
      <Action ID="UnpackPoseStampedMessage" pose_stamped="{bag_pose}" pose="{bin_pose_msg}" header="{bin_pose_header}" />
      <Action ID="UnpackPoseMessage" pose="{bin_pose_msg}" position="{bin_position}" orientation="{bin_orientation}" />
      <Action ID="UnpackPointMessage" point="{bin_position}" x="{bin_center_x}" y="{bin_center_y}" z="{bin_center_z}" />
      <Action
        ID="Script"
        name="BinInsideDimensions"
        code="bag_length := 0.4445; bag_width := 0.3175; bag_height := 0.2794; bag_floor_z := bin_center_z - bag_height / 2.0"
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Calibrated Bag">
      <MetadataFields>
        <Metadata runnable="false" />
        <Metadata subcategory="3. Calibration Routine" />
      </MetadataFields>
      <output_port name="bag_pose" default="{bag_pose}">
        Bin centre in world. Calibrated from the touched outer front-left rim corner; bin axes
        are fixed to world X/Y/Z.
      </output_port>
      <output_port name="bag_length" default="{bag_length}">Interior width along world X, in metres.</output_port>
      <output_port name="bag_width" default="{bag_width}">Interior depth along world Y, in metres.</output_port>
      <output_port name="bag_height" default="{bag_height}">Wall height above the table, in metres.</output_port>
      <output_port name="bag_floor_z" default="{bag_floor_z}">World z of the bin floor (the tabletop).</output_port>
    </SubTree>
  </TreeNodesModel>
</root>
